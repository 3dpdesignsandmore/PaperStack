{
  "expo": {
    "name": "PaperStack",
    "slug": "paperstack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paperstack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tdpdesignsandmore.paperstack",
      "infoPlist": {
        "NSCameraUsageDescription": "PaperStack uses the camera to scan documents and receipts.",
        "NSPhotoLibraryAddUsageDescription": "PaperStack saves scans and exported PDFs to your photo library."
      }
    },
    "android": {
      "package": "com.tdpdesignsandmore.paperstack",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e673687-e7e4-42e8-b23e-8e3685c6518e"
      }
    },
    "owner": "tdpdesignsandmores-team"
  }
}
